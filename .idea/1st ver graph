import tkinter as tk
from tkinter import ttk
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from datetime import datetime, timedelta
import random

# Sample data generator
def generate_sample_data():
    today = datetime.now()
    dates = [today - timedelta(days=i) for i in range(30)][::-1]
    prices = [random.uniform(100, 200) for _ in range(30)]
    return dates, prices

# Main App
class StockGraphApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Stock Simulator - Price Chart")
        self.geometry("800x600")
        self.configure(bg="#f0f2f5")

        self.create_widgets()

    def create_widgets(self):
        title = ttk.Label(self, text="Stock Price Chart", font=("Helvetica", 20, "bold"), background="#f0f2f5")
        title.pack(pady=20)

        self.graph_frame = ttk.Frame(self)
        self.graph_frame.pack(fill="both", expand=True, padx=20, pady=20)

        self.plot_graph()

    def plot_graph(self):
        dates, prices = generate_sample_data()

        fig, ax = plt.subplots(figsize=(8, 5))
        ax.plot(dates, prices, marker='o', linestyle='-', color="#4a90e2")
        ax.set_title("Stock Price Over Time", fontsize=16)
        ax.set_xlabel("Date", fontsize=12)
        ax.set_ylabel("Price (USD)", fontsize=12)

        ax.xaxis.set_major_formatter(mdates.DateFormatter('%Y-%m-%d'))
        fig.autofmt_xdate()

        ax.grid(True, linestyle="--", alpha=0.7)

        canvas = FigureCanvasTkAgg(fig, master=self.graph_frame)
        canvas.draw()
        canvas.get_tk_widget().pack(fill="both", expand=True)

if __name__ == "__main__":
    app = StockGraphApp()
    app.mainloop()
